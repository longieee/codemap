+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn edge(kind: &str, conf: Option<&str>) -> RuntimeEdge {
+        RuntimeEdge {
+            from: "A".into(),
+            to: "B".into(),
+            edge_type: kind.into(),
+            endpoint: None,
+            condition: None,
+            provenance: None,
+            owner: None,
+            store: None,
+            collections: None,
+            access: None,
+            role: None,
+            schedule: None,
+            via: None,
+            value: None,
+            source: None,
+            extracted_from: None,
+            confidence: conf.map(|s| s.to_string()),
+            grounded: None,
+            endpoint_expr: None,
+            unresolved_exprs: None,
+            external_target: false,
+        }
+    }
+
+    #[test]
+    fn test_class_is_decided_by_type_only() {
+        let dyn_e = edge("dynamic", Some("low"));
+        let http_low = edge("http-call", Some("low"));
+        let http_high = edge("http-call", Some("high"));
+        assert!(dyn_e.is_dynamic());
+        // A LOW-confidence http-call is NOT a dynamic candidate: confidence is a separate
+        // axis, and folding it into the class would misfile a resolved-but-weak edge.
+        assert!(!http_low.is_dynamic());
+        assert!(!http_high.is_dynamic());
+    }
+
+    #[test]
+    fn test_edge_class_partitions_the_set() {
+        let edges = vec![
+            edge("dynamic", Some("low")),
+            edge("http-call", Some("low")),
+            edge("shares-datastore", None),
+        ];
+        let keep = |c: EdgeClass| edges.iter().filter(|e| c.keeps(e)).count();
+        assert_eq!(keep(EdgeClass::All), 3);
+        assert_eq!(keep(EdgeClass::Dynamic), 1);
+        assert_eq!(keep(EdgeClass::Resolved), 2);
+        // resolved + dynamic must exactly partition all -- no edge counted twice or lost
+        assert_eq!(keep(EdgeClass::Resolved) + keep(EdgeClass::Dynamic), keep(EdgeClass::All));
+    }
+
+    #[test]
+    fn test_default_class_is_all() {
+        // Hiding dynamic candidates by default would reintroduce the silent recall hole
+        // they exist to expose.
+        assert_eq!(EdgeClass::default(), EdgeClass::All);
+    }
+}
