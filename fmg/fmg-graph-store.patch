+/// Compile `[scan] exclude` glob patterns into anchored regexes matched per path component.
+///
+/// Glob surface: `*`, `?`, `[seq]` and `[!seq]` — deliberately the same surface as Python's
+/// `fnmatch`, because the serving-side lint reads the same `[scan] exclude` key with
+/// `fnmatch` and the two must grade the same page set. Everything else is literal, and an
+/// unterminated `[` is a literal `[` (as `fnmatch` also treats it).
+/// An unparseable pattern is reported and skipped rather than silently widening the scan.
+pub fn compile_excludes(patterns: &[String]) -> Vec<regex::Regex> {
+    let mut out = Vec::new();
+    for p in patterns {
+        let mut re = String::from("^");
+        let chars: Vec<char> = p.chars().collect();
+        let mut i = 0;
+        while i < chars.len() {
+            match chars[i] {
+                '*' => {
+                    re.push_str(".*");
+                    i += 1;
+                }
+                '?' => {
+                    re.push('.');
+                    i += 1;
+                }
+                '[' => {
+                    // Find the closing bracket; a `]` immediately after `[` or `[!` is a literal.
+                    let mut j = i + 1;
+                    if j < chars.len() && (chars[j] == '!' || chars[j] == '^') {
+                        j += 1;
+                    }
+                    if j < chars.len() && chars[j] == ']' {
+                        j += 1;
+                    }
+                    while j < chars.len() && chars[j] != ']' {
+                        j += 1;
+                    }
+                    if j >= chars.len() {
+                        // Unterminated class: literal '['.
+                        re.push_str(&regex::escape("["));
+                        i += 1;
+                        continue;
+                    }
+                    let inner: String = chars[i + 1..j].iter().collect();
+                    let inner = if let Some(rest) = inner.strip_prefix('!') {
+                        format!("^{rest}")
+                    } else {
+                        inner
+                    };
+                    // `\` and `]` inside the class must not terminate or escape it.
+                    let inner = inner.replace('\\', "\\\\");
+                    re.push('[');
+                    re.push_str(&inner);
+                    re.push(']');
+                    i = j + 1;
+                }
+                c => {
+                    re.push_str(&regex::escape(&c.to_string()));
+                    i += 1;
+                }
+            }
+        }
+        re.push('$');
+        match regex::Regex::new(&re) {
+            Ok(r) => out.push(r),
+            Err(e) => eprintln!("Warning: ignoring invalid [scan] exclude pattern {p:?}: {e}"),
+        }
+    }
+    out
+}
